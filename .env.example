# PostgreSQL connection string (Neon, Supabase, or any Postgres host)
DATABASE_URL="postgresql://user:password@host:5432/school_portal"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob — required for file uploads (homework/announcement
# attachments, grade schedules, general files). Vercel sets this
# automatically once you connect a Blob store to the project (Vercel
# dashboard -> Storage -> Create Database -> Blob -> Connect Project).
# No value needed locally unless you want to test uploads outside Vercel.
BLOB_READ_WRITE_TOKEN=

# Future notification providers (not required yet — see lib/notifications.ts)
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
