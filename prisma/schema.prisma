// ============================================================
// School Homework & Parent Portal — Database Schema
// PostgreSQL via Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// AUTH / PEOPLE
// ------------------------------------------------------------

// Single admin today. Role field + extra tables below let us add
// teacher/parent logins later without touching this model.
model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  homeworkCreated      Homework[]
  announcementsCreated Announcement[]

  @@map("admins")
}

// Exists today as a display record (name shown on homework/announcements).
// `email` and `passwordHash` are nullable so a teacher can be promoted to
// a real login later just by filling those fields in — no schema change.
model Teacher {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjects  TeacherSubject[]
  homeworks Homework[]

  @@map("teachers")
}

// Same "record now, login later" pattern as Teacher.
model Parent {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students ParentStudent[]

  @@map("parents")
}

// Future: login via Student ID (per the requirements doc).
model Student {
  id           String   @id @default(cuid())
  fullName     String
  studentCode  String   @unique // used for future "login by Student ID"
  passwordHash String?
  gradeId      String
  grade        Grade    @relation(fields: [gradeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parents         ParentStudent[]
  attendance      Attendance[]
  grades_records  GradeRecord[]

  @@map("students")
}

// Many-to-many: a parent can have multiple children; a student can
// (rarely) have multiple guardians with portal access.
model ParentStudent {
  parentId  String
  studentId String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@map("parent_students")
}

// ------------------------------------------------------------
// ACADEMIC STRUCTURE
// ------------------------------------------------------------

model Grade {
  id        String   @id @default(cuid())
  name      String   @unique // "الصف الأول", "الصف الثاني" ...
  slug      String   @unique // "grade-1" — used in URLs
  order     Int      @default(0) // controls display order
  createdAt DateTime @default(now())

  homeworks     Homework[]
  announcements Announcement[]
  subjects      Subject[]
  students      Student[]
  sections      GradeSection[]

  @@map("grades")
}

// A class branch/section within a grade ("Grade 1 - A", "Grade 1 - B" ...).
// Fixed at 3 per grade (A/B/C), lazily created the first time a grade is
// viewed rather than via a seed step -- see lib/grade-sections.ts. Only
// the class timetable is section-specific today; homework and
// announcements stay grade-wide (a deliberate scope decision, not an
// oversight -- see the PR that introduced this).
model GradeSection {
  id      String @id @default(cuid())
  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  name    String // "A", "B", "C"
  order   Int    @default(0)

  scheduleFileName   String?
  scheduleFileUrl    String?
  scheduleFileType   String?
  scheduleFileSizeKb Int?
  scheduleUpdatedAt  DateTime?

  // Free-text note, primarily meant for today's absent students ("الغائبون
  // اليوم: ..."), but not schema-enforced to be attendance-only -- the
  // admin can write anything short here. One box per section, always
  // overwritten (not a running log) -- matches how a physical
  // whiteboard note in a classroom works.
  note          String?   @db.Text
  noteUpdatedAt DateTime?

  @@unique([gradeId, name])
  @@map("grade_sections")
}

model Subject {
  id       String  @id @default(cuid())
  name     String // "الرياضيات", "اللغة العربية" ...
  gradeId  String?
  grade    Grade?  @relation(fields: [gradeId], references: [id])

  homeworks Homework[]
  teachers  TeacherSubject[]

  @@map("subjects")
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

// ------------------------------------------------------------
// HOMEWORK
// ------------------------------------------------------------

enum HomeworkStatus {
  NORMAL
  IMPORTANT
}

model Homework {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  status      HomeworkStatus @default(NORMAL)

  gradeId   String
  grade     Grade   @relation(fields: [gradeId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  assignedDate DateTime
  dueDate      DateTime

  createdById String
  createdBy   Admin    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files HomeworkFile[]

  @@index([gradeId, dueDate])
  @@index([subjectId])
  @@map("homeworks")
}

model HomeworkFile {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  fileName   String
  fileUrl    String
  fileType   String // "image" | "pdf" | "docx"
  fileSizeKb Int
  uploadedAt DateTime @default(now())

  @@map("homework_files")
}

// ------------------------------------------------------------
// ANNOUNCEMENTS
// ------------------------------------------------------------

enum AnnouncementScope {
  SCHOOL_WIDE
  GRADE_SPECIFIC
}

model Announcement {
  id      String            @id @default(cuid())
  title   String
  content String            @db.Text
  scope   AnnouncementScope @default(SCHOOL_WIDE)
  isImportant Boolean       @default(false)

  gradeId String? // null when scope = SCHOOL_WIDE
  grade   Grade?  @relation(fields: [gradeId], references: [id])

  createdById String
  createdBy   Admin    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files AnnouncementFile[]

  @@index([scope, gradeId])
  @@map("announcements")
}

model AnnouncementFile {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  fileName   String
  fileUrl    String
  fileType   String // "image" | "pdf" | "docx" | "video" (future)
  fileSizeKb Int
  uploadedAt DateTime @default(now())

  @@map("announcement_files")
}

// ------------------------------------------------------------
// SITE CONTENT — admin-editable via /admin/settings. Always exactly one
// row (a soft singleton: the app finds-or-creates the first row rather
// than relying on a fixed id). Lets the homepage welcome message and the
// Contact page's address/phone/email/map location be edited without a
// code change or redeploy.
// ------------------------------------------------------------

model SiteSettings {
  id             String   @id @default(cuid())
  welcomeMessage String   @db.Text
  // Has a @default unlike the other fields here: this column is being
  // added to a table that may already have a saved row in production
  // (from the settings form introduced earlier). Without a default,
  // `prisma db push` can't backfill a required column on a non-empty
  // table in a non-interactive build and the deploy fails outright.
  aboutText      String   @default("مدرسة العنقاء مدرسة خاصة تلتزم بتقديم تعليم متميز يجمع بين الأصالة والحداثة، ونسعى من خلال هذه البوابة الإلكترونية لتسهيل التواصل بين المدرسة وأولياء الأمور والطلاب، من خلال إتاحة الواجبات اليومية والإعلانات والملفات المهمة في مكان واحد يسهل الوصول إليه في أي وقت.") @db.Text
  address        String
  phone          String
  email          String
  mapQuery       String // free-text place name/address used to build the embedded Google Maps link
  updatedAt      DateTime @updatedAt

  @@map("site_settings")
}

// ------------------------------------------------------------
// NOTIFICATIONS (architecture only — see lib/notifications.ts)
// ------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // channel not implemented yet
}

model Notification {
  id        String              @id @default(cuid())
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String
  body      String              @db.Text
  targetRef String // e.g. "homework:abc123" — what triggered this
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  @@map("notifications")
}

// ------------------------------------------------------------
// FUTURE MODULES (present in schema now so relations are ready;
// no UI built for these yet — see requirements doc "Future Features")
// ------------------------------------------------------------

model GradeRecord {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  subject   String
  score     Float
  maxScore  Float
  term      String
  createdAt DateTime @default(now())

  @@map("grade_records")
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  date      DateTime
  present   Boolean
  note      String?

  @@map("attendance")
}

model Payment {
  id        String   @id @default(cuid())
  studentId String
  amount    Float
  currency  String   @default("LYD")
  status    String // "pending" | "paid" | "overdue"
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime @default(now())

  @@map("payments")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  gradeId     String? // null = school-wide event
  createdAt   DateTime @default(now())

  @@map("calendar_events")
}
